TRADERAIL_DATABASE_URL=postgresql+psycopg://YOUR_DB_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME
TRADERAIL_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Leave all three blank to disable Google authentication.
TRADERAIL_GOOGLE_CLIENT_ID=
TRADERAIL_GOOGLE_CLIENT_SECRET=
TRADERAIL_SESSION_SECRET=
TRADERAIL_GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
TRADERAIL_FRONTEND_URL=http://127.0.0.1:5173
TRADERAIL_SESSION_COOKIE_SECURE=false
TRADERAIL_SESSION_COOKIE_SAMESITE=lax
TRADERAIL_SESSION_MAX_AGE=604800
# Separate PAPER runner process only; never started by FastAPI.
# Keep disabled until migration 0014 and PostgreSQL concurrency are verified.
TRADERAIL_PAPER_RUNNER_ENABLED=false
TRADERAIL_PAPER_RUNNER_POLL_SECONDS=15
TRADERAIL_PAPER_RUNNER_PAGE_SIZE=100
TRADERAIL_PAPER_RUNNER_CONNECT_TIMEOUT_SECONDS=5
TRADERAIL_PAPER_RUNNER_STATEMENT_TIMEOUT_MS=15000
TRADERAIL_PAPER_RUNNER_LOCK_TIMEOUT_MS=3000
TRADERAIL_PAPER_RUNNER_IDLE_TRANSACTION_TIMEOUT_MS=30000
TRADERAIL_PAPER_RUNNER_NETWORK_TIMEOUT_SECONDS=8
